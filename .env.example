# ──────────────────────────────────────────────────────────────────
# Pix Post Builder — Environment Variables (template)
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed for reference.
# ──────────────────────────────────────────────────────────────────

# ─── Server ───
# LOCAL ONLY. Do NOT set PORT on Railway — Railway injects it, and
# hard-coding it makes the container unreachable behind their proxy.
PORT=3000

# ─── Twitter / X API (OAuth 1.0a — User Context) ───
# Get from https://developer.x.com → your app → "Keys and Tokens"
# Set "App permissions" to "Read and write" BEFORE generating the
# Access Token, or posting will fail with 403.

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Twitter / X API (OAuth 2.0 PKCE — multi-user, optional) ───
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_OAUTH_CALLBACK_URL=http://localhost:3000/api/twitter/callback

# ─── OpenAI ───
# gpt-4o-mini powers the tweet captions + article writer (~$0.0001/call).
OPENAI_API_KEY=

# AI Enhance uses gpt-image-1. Quality drives ~15× the price:
#   low ≈ $0.016  |  medium ≈ $0.06  |  high ≈ $0.25   (per image)
# Defaults to medium (input_fidelity=high still preserves faces; quality mostly buys texture).
IMAGE_QUALITY=medium

# ─── Self-hosted AI upscaler on Railway (CodeFormer + Real-ESRGAN) ───
# Deploy the /upscaler folder on Railway (see upscaler/README.md), then set
# its public URL + the shared secret here. When set, AI Enhance uses this
# (pixel-faithful, no per-image fee) and gpt-image-1.5 becomes the fallback.
UPSCALER_URL=
UPSCALER_SECRET=

# ─── Self-hosted media service on Railway (yt-dlp + ffmpeg) ───
# Powers the Slide 2 video feature: YouTube/Instagram scraping, local video
# upload, trimming, and burning the Pix branding into the exported MP4.
# Deploy the /media folder on Railway (see media/README.md).
#
# The BROWSER calls this service directly — Vercel caps request bodies at
# 4.5 MB, far below a video upload. /api/media-token signs a short-lived
# token with MEDIA_SECRET so the secret itself never reaches the client,
# which is why the same value must be set on BOTH sides.
#
# Leave MEDIA_URL empty to hide/disable the video feature entirely.
MEDIA_URL=
MEDIA_SECRET=

# ─── fal.ai / Flux image generation ───
# Get from https://fal.ai/dashboard/keys
FAL_KEY=

# ─── Shortly Agents access gate ───
# Must match the secret used by Shortly Agents to sign Pix access tokens.
SHORTLY_AGENT_AUTH_SECRET=

# ─── Pexels (stock images) ───
# Get from https://www.pexels.com/api/ (free). Without it the stock-image
# source is skipped — /api/stock-images returns "Pexels API key is missing"
# and the app falls back to web image search.
PEXELS_API_KEY=
