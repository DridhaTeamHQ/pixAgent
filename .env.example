# ──────────────────────────────────────────────────────────────────
# Pix Post Builder — Environment Variables (template)
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored; .env.example is committed for reference.
# ──────────────────────────────────────────────────────────────────

# ─── Server ───
# LOCAL ONLY. Do NOT set PORT on Railway — Railway injects it, and
# hard-coding it makes the container unreachable behind their proxy.
PORT=3000

# ─── Twitter / X API (OAuth 1.0a — User Context) ───
# Get from https://developer.x.com → your app → "Keys and Tokens"
# Set "App permissions" to "Read and write" BEFORE generating the
# Access Token, or posting will fail with 403.

TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ─── Twitter / X API (OAuth 2.0 PKCE — multi-user, optional) ───
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_OAUTH_CALLBACK_URL=http://localhost:3000/api/twitter/callback

# ─── OpenAI ───
# gpt-4o-mini powers the tweet captions + article writer (~$0.0001/call).
OPENAI_API_KEY=

# AI Enhance uses gpt-image-1. Quality drives ~15× the price:
#   low ≈ $0.016  |  medium ≈ $0.06  |  high ≈ $0.25   (per image)
# Defaults to medium (input_fidelity=high still preserves faces; quality mostly buys texture).
IMAGE_QUALITY=medium

# ─── Upscaling ───
# NOTHING TO SET. Upscaling goes to the Pix Upscaler GPT by default: the user
# copies the image out of Pix, upscales it on their OWN ChatGPT account, and
# pastes the result back. /api/upscale-image is disabled, so this deployment
# cannot spend a cent on images.
#
#   UPSCALER_GPT_URL=<url>   point at a different GPT (no redeploy needed)
#   UPSCALER_GPT_URL=off     restore the in-app enhance button
#
# The two below only apply after UPSCALER_GPT_URL=off — deploy the /upscaler
# folder (see upscaler/README.md) and set its public URL + shared secret.
UPSCALER_URL=
UPSCALER_SECRET=

# ─── Slide 2 video (yt-dlp + ffmpeg) ───
# Runs IN this server — no separate service, no URL, no shared secret.
# The Docker image installs ffmpeg and the yt-dlp binary; /health reports
# whether both were found.
#
# Cookies are what make YouTube work from a datacenter IP (it bot-checks
# them) and are required for most of Instagram. Export cookies.txt from a
# logged-in browser, then base64 it (Railway's variable field is one line):
#     base64 -w0 cookies.txt
# Use a THROWAWAY account — these are full session credentials and
# automated access can get an account banned.
YTDLP_COOKIES=

# Optional caps.
# MAX_CLIP_SECONDS=90
# MAX_UPLOAD_BYTES=314572800

# ─── fal.ai / Flux image generation ───
# Get from https://fal.ai/dashboard/keys
FAL_KEY=

# ─── Shortly Agents access gate ───
# Must match the secret used by Shortly Agents to sign Pix access tokens.
SHORTLY_AGENT_AUTH_SECRET=

# ─── Pexels (stock images) ───
# Get from https://www.pexels.com/api/ (free). Without it the stock-image
# source is skipped — /api/stock-images returns "Pexels API key is missing"
# and the app falls back to web image search.
PEXELS_API_KEY=
